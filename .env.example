BOT_TOKEN=your_telegram_bot_token_here
# Необязательно. HTTP(S) или SOCKS-прокси только для скачивания YouTube.
# Пример: YOUTUBE_PROXY=socks5://127.0.0.1:1080
# YOUTUBE_PROXY=

# Токен своего аккаунта Яндекс Музыки. Без него полный трек не скачивается.
# Заголовок Authorization у запросов к api.music.yandex.net: OAuth <токен>
# YANDEX_MUSIC_TOKEN=

# Токен пользователя ВК с доступом к аудио.
# VK_ACCESS_TOKEN=
